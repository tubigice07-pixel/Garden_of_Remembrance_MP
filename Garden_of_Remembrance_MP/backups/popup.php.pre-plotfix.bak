              <button type="button" class="btn btn-outline-danger" onclick="confirmDeleteDeceased(${deceased.deceased_id || 'null'})"><i class="fas fa-trash me-1"></i>Delete</button>
              ${canAdd ? '<button type="button" class="btn btn-primary" onclick="showAddDeceasedModal(\'' + (deceased.section || section) + '\',' + (deceased.plot_x || plotX) + ',' + (deceased.plot_y || plotY) + ')"><i class="fas fa-plus me-1"></i>Add Deceased</button>' : '<span class="badge bg-secondary">Max occupants (7) reached</span>'}
              <?php endif; ?>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-4 col-12 mt-3 mt-lg-0">
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
          <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h6 class="mb-0">All Occupants</h6>
              <span class="badge bg-light text-dark">${count}</span>
            </div>

              foreach ($plotsF as $pF) {
                $kF = $pF[0] . '-' . $pF[1];
                if (!isset($seenF[$kF])) { $seenF[$kF] = true; $uniquePlotsF[] = $pF; }
              }
              foreach ($uniquePlotsF as $plotF) {
                list($x, $y, $left, $top, $box_w, $box_h) = $plotF;
                $hasDeceasedF = isset($deceasedF[$y][$x]);

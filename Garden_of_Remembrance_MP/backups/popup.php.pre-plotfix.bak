                <i class="fas fa-directions me-1"></i>Navigate
              </button>
              <?php if (strtoupper(trim($_SESSION['role'] ?? 'USER')) === 'ADMIN'): ?>
              <button type="button" class="btn btn-outline-secondary" onclick="window.location.href = '../map.php?move=1&deceased_id=' + (${deceased.deceased_id || 'null'});"><i class="fas fa-arrows-alt me-1"></i>Move</button>

<script>
  function closePopup() {
    try {
      // If inside iframe within dashboard modal, close the parent modal
      if (window.top !== window.self && window.parent && window.parent.document) {
        var modalEl = window.parent.document.getElementById('popupSectionModal');
        if (modalEl && window.parent.bootstrap) {
          var inst = window.parent.bootstrap.Modal.getInstance(modalEl);
          if (!inst) { inst = new window.parent.bootstrap.Modal(modalEl); }
          inst.hide();
          return;
        }
      }
    } catch (e) { /* ignore and fallback */ }
    // Standalone fallback: go back if possible, else go to map
    if (window.history.length > 1) {
      window.history.back();
    } else {
      window.location.href = '../map.php';
    }
  }
  // Hide the internal close button when embedded inside the dashboard iframe
  document.addEventListener('DOMContentLoaded', function() {
    try {
      if (window.top !== window.self) {
        var btn = document.getElementById('internalCloseBtn');
        if (btn) btn.style.display = 'none';
      }
    } catch (e) { /* no-op */ }
  });
</script>

<div class="title-block">
  <div class="title-main">Cemetery Management and Grave Mapping System</div>
  <div class="title-sub">Entity Relationship Diagram (ERD)</div>
</div>

<!-- ================= 1. VISUAL ERD DIAGRAM (CONNECTED WITH LINES) ================= -->
<div class="diagram-container">
  <!--[if gte vml 1]>
  <v:rect id="erd_image_rect" style="width:10.2in;height:6.8in;" stroked="f">
    <v:imagedata src="cemetery_erd_diagram.jpg" o:title="ERD Diagram"/>

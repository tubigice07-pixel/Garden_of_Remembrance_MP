<html xmlns:o="urn:schemas-microsoft-com:office:office"
      xmlns:w="urn:schemas-microsoft-com:office:word"
      xmlns="http://www.w3.org/TR/REC-html40">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<!--[if gte mso 9]>
<xml>
  <w:WordDocument>
    <w:View>Print</w:View>
    <w:Zoom>100</w:Zoom>
    <w:DoNotOptimizeForBrowser/>
  </w:WordDocument>
</xml>
<![endif]-->
<style>
  @page {
    size: 8.5in 11.0in; /* Portrait */
    margin: 0.8in 0.8in 0.8in 0.8in;
    mso-header-margin: 0.4in;
    mso-footer-margin: 0.4in;
  }
  body {
    font-family: Arial, sans-serif;
    font-size: 8.5pt;
    line-height: 1.25;
    color: #000000;
    background-color: #ffffff;
  }
  .title-block {
    text-align: center;
    margin-bottom: 18pt;
    padding-bottom: 8pt;
    border-bottom: 2px solid #000000;
  }
  .title-main {
    font-size: 14.5pt;
    font-weight: bold;
    text-transform: uppercase;
    color: #000000;
  }
  .title-sub {
    font-size: 10.5pt;
    font-weight: bold;
    color: #000000;
    margin-top: 3pt;
  }
  
  .table-title {
    font-size: 10.5pt;
    font-weight: bold;
    color: #000000;
    margin-top: 14pt;
    margin-bottom: 4pt;
    font-family: Arial, sans-serif;
  }
  
  /* Strictly Monochrome Black and White Tables */
  table.schema-table {
    width: 100%;
    border-collapse: collapse;
    border: 1.5px solid #000000;
    margin-bottom: 12pt;
    background-color: #ffffff;
    page-break-inside: avoid;
  }
  table.schema-table th {
    background-color: #ffffff;
    color: #000000;
    font-size: 8pt;
    font-weight: bold;
    text-align: left;
    padding: 4px 6px;
    border: 1px solid #000000;
    text-transform: uppercase;
  }
  table.schema-table td {
    font-size: 7.5pt;
    color: #000000;
    padding: 3.5px 5px;
    border: 1px solid #000000;
    vertical-align: top;
  }
  table.schema-table td.col-mono {
    font-family: 'Lucida Console', 'Courier New', monospace;
  }
  table.schema-table td.col-center {
    text-align: center;
    font-weight: bold;
  }
</style>
</head>
<body>

<div class="title-block">
  <div class="title-main">Garden of Remembrance Memorial Park CMIS</div>
  <div class="title-sub">Data Dictionary &amp; Relational Database Schema Specifications</div>
</div>

<!-- 1. tbl_user -->
<div class="table-title">1. tbl_user (User Accounts &amp; Authentication)</div>
<table class="schema-table">
  <thead>
    <tr>
      <th style="width: 22%;">Field Name</th>
      <th style="width: 15%;">Data Type</th>
      <th style="width: 8%;">Null</th>
      <th style="width: 8%;">Key</th>
      <th style="width: 15%;">Default</th>
      <th style="width: 32%;">Description</th>
    </tr>
  </thead>
  <tbody>
    <tr><td class="col-mono">user_id</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center">PK</td><td>AUTO_INCREMENT</td><td>Primary key for user account</td></tr>
    <tr><td class="col-mono">role</td><td class="col-mono">VARCHAR(20)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Role: ADMIN, STAFF, or CLIENT</td></tr>
    <tr><td class="col-mono">first_name</td><td class="col-mono">VARCHAR(50)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Given first name</td></tr>
    <tr><td class="col-mono">middle_name</td><td class="col-mono">VARCHAR(50)</td><td class="col-center">YES</td><td class="col-center"></td><td>NULL</td><td>Middle name</td></tr>
    <tr><td class="col-mono">last_name</td><td class="col-mono">VARCHAR(50)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Last name / surname</td></tr>
    <tr><td class="col-mono">suffix</td><td class="col-mono">VARCHAR(50)</td><td class="col-center">YES</td><td class="col-center"></td><td>''</td><td>Suffix (Jr, Sr, III)</td></tr>
    <tr><td class="col-mono">birthday</td><td class="col-mono">DATE</td><td class="col-center">YES</td><td class="col-center"></td><td>NULL</td><td>Birth date</td></tr>
    <tr><td class="col-mono">email</td><td class="col-mono">VARCHAR(255)</td><td class="col-center">NO</td><td class="col-center">UK</td><td>None</td><td>Unique email address</td></tr>
    <tr><td class="col-mono">password</td><td class="col-mono">VARCHAR(250)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Bcrypt password hash</td></tr>
    <tr><td class="col-mono">phone_no</td><td class="col-mono">VARCHAR(20)</td><td class="col-center">YES</td><td class="col-center"></td><td>''</td><td>Contact phone number</td></tr>
    <tr><td class="col-mono">account_number</td><td class="col-mono">VARCHAR(20)</td><td class="col-center">YES</td><td class="col-center"></td><td>NULL</td><td>Customer account identifier</td></tr>
    <tr><td class="col-mono">email_verified</td><td class="col-mono">TINYINT(1)</td><td class="col-center">YES</td><td class="col-center"></td><td>0</td><td>1 = Verified, 0 = Pending</td></tr>
  </tbody>
</table>

<!-- 2. tbl_admin -->
<div class="table-title">2. tbl_admin (Administrator Profiles)</div>
<table class="schema-table">
  <thead>
    <tr>
      <th style="width: 22%;">Field Name</th>
      <th style="width: 15%;">Data Type</th>
      <th style="width: 8%;">Null</th>
      <th style="width: 8%;">Key</th>
      <th style="width: 15%;">Default</th>
      <th style="width: 32%;">Description</th>
    </tr>
  </thead>
  <tbody>
    <tr><td class="col-mono">admin_id</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center">PK</td><td>AUTO_INCREMENT</td><td>Administrator unique ID</td></tr>
    <tr><td class="col-mono">user_id</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center">FK, UK</td><td>None</td><td>Foreign key to tbl_user (1:1 subtype)</td></tr>
    <tr><td class="col-mono">full_name</td><td class="col-mono">VARCHAR(100)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Administrator display name</td></tr>
    <tr><td class="col-mono">email</td><td class="col-mono">VARCHAR(255)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Administrative email</td></tr>
    <tr><td class="col-mono">role</td><td class="col-mono">VARCHAR(30)</td><td class="col-center">NO</td><td class="col-center"></td><td>'Admin'</td><td>Security authorization tier</td></tr>
  </tbody>
</table>

<!-- 3. tbl_plots -->
<div class="table-title">3. tbl_plots (Cemetery Interactive Plot Grid)</div>
<table class="schema-table">
  <thead>
    <tr>
      <th style="width: 22%;">Field Name</th>
      <th style="width: 15%;">Data Type</th>
      <th style="width: 8%;">Null</th>
      <th style="width: 8%;">Key</th>
      <th style="width: 15%;">Default</th>
      <th style="width: 32%;">Description</th>
    </tr>
  </thead>
  <tbody>
    <tr><td class="col-mono">plot_id</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center">PK</td><td>AUTO_INCREMENT</td><td>Unique plot grid ID</td></tr>
    <tr><td class="col-mono">section</td><td class="col-mono">VARCHAR(10)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Section code (Sections A through F)</td></tr>
    <tr><td class="col-mono">row</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Physical plot row number</td></tr>
    <tr><td class="col-mono">plot_number</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Physical plot column/number</td></tr>
    <tr><td class="col-mono">plot_x</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Interactive 2D map X coordinate</td></tr>
    <tr><td class="col-mono">plot_y</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Interactive 2D map Y coordinate</td></tr>
    <tr><td class="col-mono">lawn_type</td><td class="col-mono">VARCHAR(100)</td><td class="col-center">YES</td><td class="col-center"></td><td>NULL</td><td>Lawn type / pricing tier classification</td></tr>
    <tr><td class="col-mono">price</td><td class="col-mono">DECIMAL(10,2)</td><td class="col-center">YES</td><td class="col-center"></td><td>0.00</td><td>Standard lot price in PHP</td></tr>
    <tr><td class="col-mono">status</td><td class="col-mono">ENUM</td><td class="col-center">YES</td><td class="col-center"></td><td>'available'</td><td>'available', 'reserved', 'occupied'</td></tr>
  </tbody>
</table>

<!-- 4. tbl_deceased -->
<div class="table-title">4. tbl_deceased (Deceased &amp; Interment Registry)</div>
<table class="schema-table">
  <thead>
    <tr>
      <th style="width: 22%;">Field Name</th>
      <th style="width: 15%;">Data Type</th>
      <th style="width: 8%;">Null</th>
      <th style="width: 8%;">Key</th>
      <th style="width: 15%;">Default</th>
      <th style="width: 32%;">Description</th>
    </tr>
  </thead>
  <tbody>
    <tr><td class="col-mono">deceased_id</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center">PK</td><td>AUTO_INCREMENT</td><td>Unique deceased record ID</td></tr>
    <tr><td class="col-mono">user_id</td><td class="col-mono">INT(11)</td><td class="col-center">YES</td><td class="col-center">FK</td><td>NULL</td><td>Foreign key to client tbl_user account</td></tr>
    <tr><td class="col-mono">relationship_to_account_holder</td><td class="col-mono">VARCHAR(40)</td><td class="col-center">YES</td><td class="col-center"></td><td>NULL</td><td>Relationship (Parent, Spouse, etc.)</td></tr>
    <tr><td class="col-mono">first_name</td><td class="col-mono">VARCHAR(50)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Deceased first name</td></tr>
    <tr><td class="col-mono">middle_name</td><td class="col-mono">VARCHAR(50)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Deceased middle name</td></tr>
    <tr><td class="col-mono">last_name</td><td class="col-mono">VARCHAR(50)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Deceased last name</td></tr>
    <tr><td class="col-mono">suffix</td><td class="col-mono">VARCHAR(20)</td><td class="col-center">NO</td><td class="col-center"></td><td>''</td><td>Generational suffix</td></tr>
    <tr><td class="col-mono">bday</td><td class="col-mono">DATE</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Birth date</td></tr>
    <tr><td class="col-mono">born_in</td><td class="col-mono">VARCHAR(50)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Place of birth</td></tr>
    <tr><td class="col-mono">date_died</td><td class="col-mono">DATE</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Date of passing</td></tr>
    <tr><td class="col-mono">interment_date</td><td class="col-mono">DATE</td><td class="col-center">YES</td><td class="col-center"></td><td>NULL</td><td>Burial / Interment date (for transfer policy)</td></tr>
    <tr><td class="col-mono">funeral_service</td><td class="col-mono">VARCHAR(100)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Mortuary service provider</td></tr>
    <tr><td class="col-mono">section</td><td class="col-mono">VARCHAR(20)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Interment section code</td></tr>
    <tr><td class="col-mono">plot_x</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Interment map X coordinate</td></tr>
    <tr><td class="col-mono">plot_y</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Interment map Y coordinate</td></tr>
  </tbody>
</table>

<!-- 5. tbl_bookings -->
<div class="table-title">5. tbl_bookings (Master Booking Contracts)</div>
<table class="schema-table">
  <thead>
    <tr>
      <th style="width: 22%;">Field Name</th>
      <th style="width: 15%;">Data Type</th>
      <th style="width: 8%;">Null</th>
      <th style="width: 8%;">Key</th>
      <th style="width: 15%;">Default</th>
      <th style="width: 32%;">Description</th>
    </tr>
  </thead>
  <tbody>
    <tr><td class="col-mono">id</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center">PK</td><td>AUTO_INCREMENT</td><td>Master contract booking number</td></tr>
    <tr><td class="col-mono">user_id</td><td class="col-mono">INT(11)</td><td class="col-center">YES</td><td class="col-center">FK</td><td>NULL</td><td>Foreign key to client tbl_user</td></tr>
    <tr><td class="col-mono">plot_id</td><td class="col-mono">INT(11)</td><td class="col-center">YES</td><td class="col-center">FK</td><td>NULL</td><td>Foreign key to tbl_plots</td></tr>
    <tr><td class="col-mono">deceased_id</td><td class="col-mono">INT(11)</td><td class="col-center">YES</td><td class="col-center">FK</td><td>NULL</td><td>Foreign key to tbl_deceased</td></tr>
    <tr><td class="col-mono">service_type</td><td class="col-mono">VARCHAR(50)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Burial Service, Grave Reservation, etc.</td></tr>
    <tr><td class="col-mono">grave_location</td><td class="col-mono">VARCHAR(100)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Text description of plot location</td></tr>
    <tr><td class="col-mono">section_plot</td><td class="col-mono">VARCHAR(20)</td><td class="col-center">YES</td><td class="col-center"></td><td>NULL</td><td>Combined plot label (e.g. B-38-1)</td></tr>
    <tr><td class="col-mono">plot_price</td><td class="col-mono">DECIMAL(10,2)</td><td class="col-center">YES</td><td class="col-center"></td><td>0.00</td><td>Total plot agreed price</td></tr>
    <tr><td class="col-mono">amount_paid</td><td class="col-mono">DECIMAL(10,2)</td><td class="col-center">YES</td><td class="col-center"></td><td>0.00</td><td>Total verified amount paid</td></tr>
    <tr><td class="col-mono">remaining_balance</td><td class="col-mono">DECIMAL(10,2)</td><td class="col-center">YES</td><td class="col-center"></td><td>0.00</td><td>Remaining contract balance</td></tr>
    <tr><td class="col-mono">payment_status</td><td class="col-mono">VARCHAR(20)</td><td class="col-center">YES</td><td class="col-center"></td><td>'PENDING'</td><td>PENDING, PARTIALLY_PAID, PAID</td></tr>
    <tr><td class="col-mono">status</td><td class="col-mono">VARCHAR(20)</td><td class="col-center">YES</td><td class="col-center"></td><td>'pending'</td><td>pending, approved, rejected, completed</td></tr>
    <tr><td class="col-mono">preferred_date</td><td class="col-mono">DATE</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Target schedule / interment date</td></tr>
    <tr><td class="col-mono">contact_number</td><td class="col-mono">VARCHAR(20)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Booker contact telephone</td></tr>
  </tbody>
</table>

<!-- 6. tbl_booking_payment_schedule -->
<div class="table-title">6. tbl_booking_payment_schedule (Installment Milestones)</div>
<table class="schema-table">
  <thead>
    <tr>
      <th style="width: 22%;">Field Name</th>
      <th style="width: 15%;">Data Type</th>
      <th style="width: 8%;">Null</th>
      <th style="width: 8%;">Key</th>
      <th style="width: 15%;">Default</th>
      <th style="width: 32%;">Description</th>
    </tr>
  </thead>
  <tbody>
    <tr><td class="col-mono">id</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center">PK</td><td>AUTO_INCREMENT</td><td>Installment item unique ID</td></tr>
    <tr><td class="col-mono">booking_id</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center">FK</td><td>None</td><td>Foreign key to tbl_bookings</td></tr>
    <tr><td class="col-mono">installment_number</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Installment sequence index (1, 2, 3...)</td></tr>
    <tr><td class="col-mono">due_date</td><td class="col-mono">DATE</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Payment due date</td></tr>
    <tr><td class="col-mono">amount_due</td><td class="col-mono">DECIMAL(10,2)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Installment amount in PHP</td></tr>
    <tr><td class="col-mono">amount_paid</td><td class="col-mono">DECIMAL(10,2)</td><td class="col-center">NO</td><td class="col-center"></td><td>0.00</td><td>Amount paid for this installment</td></tr>
    <tr><td class="col-mono">status</td><td class="col-mono">VARCHAR(20)</td><td class="col-center">NO</td><td class="col-center"></td><td>'UNPAID'</td><td>'UNPAID', 'PAID', 'OVERDUE'</td></tr>
    <tr><td class="col-mono">paid_at</td><td class="col-mono">DATETIME</td><td class="col-center">YES</td><td class="col-center"></td><td>NULL</td><td>Payment settlement timestamp</td></tr>
  </tbody>
</table>

<!-- 7. payment_receipts -->
<div class="table-title">7. payment_receipts (Official Verification &amp; Transaction Ledger)</div>
<table class="schema-table">
  <thead>
    <tr>
      <th style="width: 22%;">Field Name</th>
      <th style="width: 15%;">Data Type</th>
      <th style="width: 8%;">Null</th>
      <th style="width: 8%;">Key</th>
      <th style="width: 15%;">Default</th>
      <th style="width: 32%;">Description</th>
    </tr>
  </thead>
  <tbody>
    <tr><td class="col-mono">id</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center">PK</td><td>AUTO_INCREMENT</td><td>Receipt transaction ID</td></tr>
    <tr><td class="col-mono">booking_id</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center">FK</td><td>None</td><td>Foreign key to tbl_bookings</td></tr>
    <tr><td class="col-mono">user_id</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center">FK</td><td>None</td><td>Foreign key to payer tbl_user</td></tr>
    <tr><td class="col-mono">payment_schedule_id</td><td class="col-mono">INT(11)</td><td class="col-center">YES</td><td class="col-center">FK</td><td>NULL</td><td>Foreign key to tbl_booking_payment_schedule</td></tr>
    <tr><td class="col-mono">installment_number</td><td class="col-mono">INT(11)</td><td class="col-center">YES</td><td class="col-center"></td><td>NULL</td><td>Target installment number</td></tr>
    <tr><td class="col-mono">receipt_number</td><td class="col-mono">VARCHAR(50)</td><td class="col-center">NO</td><td class="col-center">UK</td><td>None</td><td>Official CMIS Receipt Number</td></tr>
    <tr><td class="col-mono">amount</td><td class="col-mono">DECIMAL(10,2)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Payment amount received</td></tr>
    <tr><td class="col-mono">payment_method</td><td class="col-mono">VARCHAR(50)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>GCash, Cash, Bank Transfer</td></tr>
    <tr><td class="col-mono">gcash_reference_number</td><td class="col-mono">VARCHAR(100)</td><td class="col-center">YES</td><td class="col-center"></td><td>NULL</td><td>13-digit GCash Reference Number</td></tr>
    <tr><td class="col-mono">status</td><td class="col-mono">ENUM</td><td class="col-center">NO</td><td class="col-center"></td><td>'ISSUED'</td><td>'ISSUED', 'VERIFIED', 'VOID'</td></tr>
    <tr><td class="col-mono">verified_by</td><td class="col-mono">INT(11)</td><td class="col-center">YES</td><td class="col-center">FK</td><td>NULL</td><td>Staff user who verified payment</td></tr>
    <tr><td class="col-mono">verified_at</td><td class="col-mono">DATETIME</td><td class="col-center">YES</td><td class="col-center"></td><td>NULL</td><td>Verification timestamp</td></tr>
  </tbody>
</table>

<!-- 8. tbl_plot_owners -->
<div class="table-title">8. tbl_plot_owners (Plot Ownership &amp; Reservation Registry)</div>
<table class="schema-table">
  <thead>
    <tr>
      <th style="width: 22%;">Field Name</th>
      <th style="width: 15%;">Data Type</th>
      <th style="width: 8%;">Null</th>
      <th style="width: 8%;">Key</th>
      <th style="width: 15%;">Default</th>
      <th style="width: 32%;">Description</th>
    </tr>
  </thead>
  <tbody>
    <tr><td class="col-mono">id</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center">PK</td><td>AUTO_INCREMENT</td><td>Ownership record ID</td></tr>
    <tr><td class="col-mono">section</td><td class="col-mono">VARCHAR(10)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Cemetery section (A-F)</td></tr>
    <tr><td class="col-mono">plot_x</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Plot coordinate X</td></tr>
    <tr><td class="col-mono">plot_y</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Plot coordinate Y</td></tr>
    <tr><td class="col-mono">reserved_by</td><td class="col-mono">INT(11)</td><td class="col-center">YES</td><td class="col-center">FK</td><td>NULL</td><td>Foreign key to client/admin tbl_user</td></tr>
    <tr><td class="col-mono">active</td><td class="col-mono">TINYINT(1)</td><td class="col-center">NO</td><td class="col-center"></td><td>1</td><td>1 = Active ownership, 0 = Inactive</td></tr>
    <tr><td class="col-mono">owner_name</td><td class="col-mono">VARCHAR(100)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Full registered owner name</td></tr>
    <tr><td class="col-mono">phone_no</td><td class="col-mono">VARCHAR(15)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Owner telephone contact</td></tr>
    <tr><td class="col-mono">address</td><td class="col-mono">VARCHAR(255)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Owner residential address</td></tr>
  </tbody>
</table>

<!-- 9. tbl_deceased_transfers -->
<div class="table-title">9. tbl_deceased_transfers (Remains Transfer &amp; Exhumation Audit)</div>
<table class="schema-table">
  <thead>
    <tr>
      <th style="width: 22%;">Field Name</th>
      <th style="width: 15%;">Data Type</th>
      <th style="width: 8%;">Null</th>
      <th style="width: 8%;">Key</th>
      <th style="width: 15%;">Default</th>
      <th style="width: 32%;">Description</th>
    </tr>
  </thead>
  <tbody>
    <tr><td class="col-mono">id</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center">PK</td><td>AUTO_INCREMENT</td><td>Transfer transaction log ID</td></tr>
    <tr><td class="col-mono">deceased_id</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center">FK</td><td>None</td><td>Foreign key to tbl_deceased</td></tr>
    <tr><td class="col-mono">deceased_name</td><td class="col-mono">VARCHAR(150)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Name of transferred deceased</td></tr>
    <tr><td class="col-mono">original_section</td><td class="col-mono">VARCHAR(20)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Original plot section</td></tr>
    <tr><td class="col-mono">original_plot_x</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Original plot coordinate X</td></tr>
    <tr><td class="col-mono">original_plot_y</td><td class="col-mono">INT(11)</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Original plot coordinate Y</td></tr>
    <tr><td class="col-mono">destination_section</td><td class="col-mono">VARCHAR(20)</td><td class="col-center">YES</td><td class="col-center"></td><td>NULL</td><td>New destination section</td></tr>
    <tr><td class="col-mono">destination_plot_x</td><td class="col-mono">INT(11)</td><td class="col-center">YES</td><td class="col-center"></td><td>NULL</td><td>New plot coordinate X</td></tr>
    <tr><td class="col-mono">destination_plot_y</td><td class="col-mono">INT(11)</td><td class="col-center">YES</td><td class="col-center"></td><td>NULL</td><td>New plot coordinate Y</td></tr>
    <tr><td class="col-mono">transfer_date</td><td class="col-mono">DATE</td><td class="col-center">NO</td><td class="col-center"></td><td>None</td><td>Date transfer was executed</td></tr>
    <tr><td class="col-mono">years_since_interment</td><td class="col-mono">DECIMAL(4,1)</td><td class="col-center">YES</td><td class="col-center"></td><td>NULL</td><td>Years elapsed since previous burial</td></tr>
    <tr><td class="col-mono">recorded_by_id</td><td class="col-mono">INT(11)</td><td class="col-center">YES</td><td class="col-center">FK</td><td>NULL</td><td>Administrator ID who recorded transfer</td></tr>
  </tbody>
</table>

</body>
</html>
